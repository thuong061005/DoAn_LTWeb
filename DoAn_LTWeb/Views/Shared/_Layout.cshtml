<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ShopBanHang</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        /* ==================== CSS TỔNG THỂ ==================== */
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-body {
            flex-grow: 1;
            padding-top: 20px;
            padding-bottom: 20px;
        }

        /* ==================== HEADER/NAVBAR ==================== */
        .top-bar {
            background-color: #171D2B !important;
            font-size: 0.75rem !important;
        }

        .navbar {
            box-shadow: 0 2px 4px rgba(0,0,0,.05);
        }

        .nav-link {
            font-weight: 500;
        }

            .nav-link.active {
                color: #dc3545 !important;
                border-bottom: 2px solid #dc3545;
            }

        .input-group input:focus {
            box-shadow: none;
            border-color: #ced4da;
        }

        .input-group .btn-outline-secondary {
            border-color: #ced4da;
            color: #6c757d;
        }

        /* ==================== FOOTER ==================== */
        .footer-content {
            background-color: #171D2B;
            color: white;
            padding-top: 40px;
            padding-bottom: 20px;
        }

            .footer-content h5 {
                color: white;
                font-weight: bold;
                margin-bottom: 15px;
            }

            .footer-content .text-secondary {
                color: #a0a4ae !important;
                font-size: 0.9rem;
                line-height: 1.8;
            }

            .footer-content a.text-secondary:hover {
                color: #ffffff !important;
            }

            .footer-content .list-unstyled li {
                margin-bottom: 8px;
            }
    </style>
</head>
<body>

    <header class="header-content sticky-top">
        <div class="top-bar bg-dark text-white-50 py-1">
            <div class="container d-flex justify-content-between align-items-center">
                <div class="top-text">Chào mừng bạn đến với ShopBanHang - Uy tín tạo niềm tin!</div>
                <a href="#" class="text-white-50 text-decoration-none">
                    <i class="fas fa-share-alt me-1"></i>Chia sẻ
                </a>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-light bg-white py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 text-dark" href="@Url.Action("Index", "Home")">
                    <i class="fas fa-store text-danger me-2"></i>ShopBanHang
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="navbarNav">

                    <ul class="navbar-nav ms-5 me-4">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "SanPham")">Sản phẩm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("About", "Home")">Về chúng tôi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Contact", "Home")">Liên hệ</a>
                        </li>
                    </ul>

                    <form class="d-flex me-4 search-form" action="@Url.Action("TimKiem", "SanPham")" method="get">
                        <div class="input-group">
                            <input class="form-control" type="search" name="keywords" placeholder="Tìm kiếm sản phẩm..." aria-label="Search" style="width: 250px;">
                            <button class="btn btn-outline-secondary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>

                    <ul class="navbar-nav d-flex flex-row align-items-center">

                        @if (Session["ID"] == null)
                        {
                            <li class="nav-item dropdown me-3">
                                <a class="nav-link" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user fs-5"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("DangNhap", "Login")">
                                            <i class="fas fa-sign-in-alt me-2"></i> Đăng nhập
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("DangKy", "Login")">
                                            <i class="fas fa-user-plus me-2"></i> Đăng ký
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown me-3">
                                <a class="nav-link d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle fs-4 me-2 text-secondary"></i>
                                    <span class="d-none d-md-block fw-bold small">@Session["HoTen"]</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                                    @if (Session["VaiTro"] != null && Session["VaiTro"].ToString() == "admin")
                                    {
                                        <li>
                                            <a class="dropdown-item text-danger fw-bold" href="@Url.Action("Index", "Admin")">
                                                <i class="fas fa-tachometer-alt me-2"></i> Trang quản trị
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Information", "Users")">
                                            <i class="fas fa-id-card me-2"></i> Thông tin cá nhân
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("LichSuDonHang", "Users")">
                                            <i class="fas fa-history me-2"></i> Lịch sử mua hàng
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("DangXuat", "Login")">
                                            <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link position-relative" href="@Url.Action("Index", "GioHang")" title="Giỏ hàng">
                                <i class="fas fa-shopping-bag fs-5"></i>

                                @{
                                    // Xử lý đếm số lượng giỏ hàng trực tiếp tại View (Simple Logic)
                                    int soLuongGioHang = 0;
                                    if (Session["ID"] != null)
                                    {
                                        try
                                        {
                                            // Đảm bảo namespace DoAn_LTWeb.Models đúng với project của bạn
                                            using (var db = new DoAn_LTWeb.Models.DB_DoAN_ShopEntities())
                                            {
                                                int idUser = int.Parse(Session["ID"].ToString());
                                                // Tính tổng số lượng item
                                                var totalQty = db.GioHangs.Where(g => g.ID == idUser).Sum(g => (int?)g.SoLuong);
                                                soLuongGioHang = totalQty ?? 0;
                                            }
                                        }
                                        catch { soLuongGioHang = 0; }
                                    }
                                }

                                @if (soLuongGioHang > 0)
                                {
                                    <span class="badge bg-danger rounded-circle position-absolute top-0 start-100 translate-middle" style="font-size: 0.65rem;">
                                        @soLuongGioHang
                                    </span>
                                }
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-body container">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer-content">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5>ShopBanHang</h5>
                    <p class="text-secondary">Chất lượng, Uy tín, Giá tốt nhất cho khách hàng. Chúng tôi cam kết mang lại trải nghiệm mua sắm tuyệt vời nhất.</p>
                    <div class="mt-3">
                        <a href="#" class="text-white me-3"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Hỗ trợ khách hàng</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-secondary text-decoration-none">Chính sách Bảo mật</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Điều khoản Dịch vụ</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Chính sách Đổi trả</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Câu hỏi thường gặp</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Liên hệ</h5>
                    <p class="text-secondary"><i class="fas fa-map-marker-alt me-2"></i> 123 Đường ABC, Quận 1, TP HCM</p>
                    <p class="text-secondary"><i class="fas fa-envelope me-2"></i> support@shopbanhang.com</p>
                    <p class="text-secondary"><i class="fas fa-phone-alt me-2"></i> (028) 123 4567</p>
                </div>
            </div>

            <div class="row border-top border-secondary pt-3 mt-3">
                <div class="col-12 text-center">
                    <p class="mb-0 text-secondary">&copy; @DateTime.Now.Year ShopBanHang. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>