<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopBanHang - Trang chủ</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        /* ==================== CSS TỔNG THỂ ==================== */
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-body {
            /* Đảm bảo nội dung chiếm hết không gian còn lại giữa Header và Footer */
            flex-grow: 1;
            padding-top: 20px;
            padding-bottom: 20px;
        }

        /* ==================== HEADER/NAVBAR ==================== */
        .top-bar {
            background-color: #171D2B !important; /* Đổi màu top-bar sang màu xanh đậm của footer */
            font-size: 0.75rem !important;
        }

        .navbar {
            box-shadow: 0 2px 4px rgba(0,0,0,.05); /* Thêm bóng nhẹ cho Navbar */
        }

        .nav-link {
            font-weight: 500;
        }

            .nav-link.active {
                color: #dc3545 !important; /* Màu đỏ nổi bật cho link active */
                border-bottom: 2px solid #dc3545;
            }

        .input-group input:focus {
            box-shadow: none;
            border-color: #ced4da;
        }

        .input-group .btn-outline-secondary {
            border-color: #ced4da;
            color: #6c757d;
        }

        /* ==================== FOOTER ==================== */
        .footer-content {
            background-color: #171D2B; /* Màu nền tối */
            color: white;
            padding-top: 40px;
            padding-bottom: 20px;
        }

            .footer-content h5 {
                color: white;
                font-weight: bold;
                margin-bottom: 15px;
            }

            .footer-content .text-secondary {
                color: #a0a4ae !important; /* Màu chữ nhạt hơn */
                font-size: 0.9rem;
                line-height: 1.8;
            }

            .footer-content a.text-secondary:hover {
                color: #ffffff !important;
            }

            .footer-content .list-unstyled li {
                margin-bottom: 8px;
            }
    </style>
</head>
<body>

    <header class="header-content sticky-top">
        <div class="top-bar bg-dark text-white-50 py-1">
            <div class="container d-flex justify-content-between align-items-center">
                <div class="top-text">Design Layout for E-Commerce</div>
                <a href="#" class="text-white-50 text-decoration-none">
                    <i class="fas fa-share-alt me-1"></i>Chia sẻ
                </a>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-light bg-white py-3">
            <div class="container">
                @Html.ActionLink("ShopBanHang", "Index", "Home", new { area = "" }, new { @class = "navbar-brand fw-bold fs-4 text-dark" })

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="navbarNav">

                    <ul class="navbar-nav ms-5 me-4">
                        <li class="nav-item">@Html.ActionLink("Trang chủ", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Sản phẩm", "View_SanPham", "SanPham", new { id = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Về chúng tôi", "About", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Liên hệ", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    </ul>

                    <form class="d-flex me-4 search-form">
                        <div class="input-group">
                            <input class="form-control" type="search" placeholder="Tìm kiếm..." aria-label="Search" style="width: 250px;">
                            <button class="btn btn-outline-secondary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>

                    <ul class="navbar-nav d-flex flex-row align-items-center">
                        @if (Session["ID"] == null)
                        {
                            <li class="nav-item dropdown me-3">
                                <a class="nav-link" href="#" title="Tài khoản"
                                   id="dropdownTaiKhoan"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <i class="fas fa-user fs-5"></i>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" aria-labelledby="dropdownTaiKhoan">
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("DangNhap", "Login")">
                                            <i class="fas fa-sign-in-alt me-2"></i> Đăng nhập
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("DangKy", "Login")">
                                            <i class="fas fa-user-plus me-2"></i> Đăng ký
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown me-3">
                                <a class="nav-link" href="#" title="Tài khoản"
                                   id="dropdownTaiKhoan"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <i class="fas fa-user fs-5"></i>
                                    <span class="d-block mt-1 small">@Session["HoTen"]</span>
                                </a>                               
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" aria-labelledby="dropdownTaiKhoan">
                                    @if (Session["VaiTro"].ToString() == "admin")
                                    {
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("DashBoard_Admin", "Admin")">
                                                <i class="fas fa-sign-in-alt me-2"></i> Quản Lý
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("UsersInformation", "Users")">
                                            <i class="fas fa-sign-in-alt me-2"></i> Thông Tin Cá Nhân
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("DangXuat", "Login")">
                                            <i class="fas fa-user-plus me-2"></i> Đăng Xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link position-relative" href="#" title="Giỏ hàng">
                                <i class="fas fa-shopping-bag fs-5"></i>
                                <span class="badge bg-danger rounded-circle position-absolute top-0 start-100 translate-middle">3</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-body container">
        @RenderBody()
        @RenderSection("Scripts", required: false)
    </main>

    <footer class="footer-content">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5>ShopBanHang</h5>
                    <p class="text-secondary">Chất lượng, Uy tín, Giá tốt nhất cho khách hàng. Chúng tôi cam kết mang lại trải nghiệm mua sắm tuyệt vời nhất.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Hỗ trợ khách hàng</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-secondary">Chính sách Bảo mật</a></li>
                        <li><a href="#" class="text-secondary">Điều khoản Dịch vụ</a></li>
                        <li><a href="#" class="text-secondary">Chính sách Đổi trả</a></li>
                        <li><a href="#" class="text-secondary">Câu hỏi thường gặp</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Liên hệ</h5>
                    <p class="text-secondary"><i class="fas fa-map-marker-alt me-2"></i> 123 Đường ABC, Quận 1, TP HCM</p>
                    <p class="text-secondary"><i class="fas fa-envelope me-2"></i> support@shoponline.com</p>
                    <p class="text-secondary"><i class="fas fa-phone-alt me-2"></i> (028) 123 4567</p>
                </div>
            </div>

            <div class="row border-top border-secondary pt-3 mt-3">
                <div class="col-12 text-center">
                    <p class="mb-0 text-secondary">&copy; 2025 Shop Online. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>