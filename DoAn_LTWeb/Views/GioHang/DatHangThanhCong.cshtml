@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-center">
    <div class="mb-4">
        <i class="fas fa-check-circle text-success" style="font-size: 80px;"></i>
    </div>
    <h2 class="fw-bold mb-3">Đặt hàng thành công!</h2>
    <p class="lead mb-4">Cảm ơn bạn đã mua sắm tại ShopBanHang. Đơn hàng của bạn đang được xử lý.</p>

    <div class="d-flex justify-content-center gap-3">
        <a href="@Url.Action("LichSuDonHang", "Users")" class="btn btn-outline-primary">Xem lịch sử đơn hàng</a>
        <a href="@Url.Action("View_TrangChu", "Home")" class="btn btn-primary">Tiếp tục mua sắm</a>
    </div>
</div>