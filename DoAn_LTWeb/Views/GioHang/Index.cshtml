@model List<DoAn_LTWeb.Models.GioHang>
@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <h2 class="mb-4 fw-bold text-uppercase">Giỏ hàng (@Model.Count sản phẩm)</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center">
            Giỏ hàng của bạn đang trống. <a href="@Url.Action("Index", "Home")" class="alert-link">Mua sắm ngay!</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="py-3 ps-4">Sản phẩm</th>
                                    <th scope="col" class="py-3">Đơn giá</th>
                                    <th scope="col" class="py-3">Số lượng</th>
                                    <th scope="col" class="py-3">Thành tiền</th>
                                    <th scope="col" class="py-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <img src="~/Content/Images/@item.SanPham.HinhAnh" alt="@item.SanPham.TenSP"
                                                     class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;">
                                                <div>
                                                    <h6 class="mb-0">@item.SanPham.TenSP</h6>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@string.Format("{0:N0}₫", item.SanPham.Gia)</td>
                                        <td>
                                            @using (Html.BeginForm("CapNhatGioHang", "GioHang", FormMethod.Get))
                                            {
                                                <input type="hidden" name="maSP" value="@item.MaSP" />
                                                <input type="number" name="soLuong" value="@item.SoLuong" min="1" max="99"
                                                       class="form-control form-control-sm d-inline-block text-center"
                                                       style="width: 60px;" onchange="this.form.submit()">
                                            }
                                        </td>
                                        <td class="fw-bold text-danger">
                                            @string.Format("{0:N0}₫", item.ThanhTien)
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="@Url.Action("XoaKhoiGio", "GioHang", new { maSP = item.MaSP })"
                                               class="text-secondary" onclick="return confirm('Bạn có chắc muốn xóa?')">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a href="@Url.Action("Index", "Home")" class="text-decoration-none">
                        <i class="fas fa-arrow-left me-2"></i> Tiếp tục mua sắm
                    </a>
                </div>
            </div>

            <div class="col-lg-4 mt-4 mt-lg-0">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold">Cộng giỏ hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Tạm tính:</span>
                            <span class="fw-bold">@string.Format("{0:N0}₫", ViewBag.TongTien)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="text-success">Miễn phí</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5 fw-bold">Tổng cộng:</span>
                            <span class="h5 fw-bold text-danger">@string.Format("{0:N0}₫", ViewBag.TongTien)</span>
                        </div>

                        <a href="@Url.Action("ThanhToan", "GioHang")" class="btn btn-dark w-100 py-2 fw-bold text-uppercase">
                            Tiến hành thanh toán
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>