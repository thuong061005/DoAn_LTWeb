@model DoAn_LTWeb.Models.SanPham

@{
    ViewBag.Title = "Chi Tiết Sản Phẩm";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-md-10">
            <div class="card shadow-lg border-0">
                @* Card Header với tông màu ĐEN (bg-dark) *@
                <div class="card-header bg-dark text-white text-center">
                    <h3 class="mb-0 py-2">
                        <i class="fas fa-box-open me-2"></i> CHI TIẾT SẢN PHẨM
                    </h3>
                </div>
                
                <div class="card-body p-4">
                    <div class="row">
                        
                        @* Cột 1: Hình ảnh Sản phẩm (4/12 cột) *@
                        <div class="col-md-4 text-center mb-4">
                            <h5 class="text-muted mb-3">Hình Ảnh</h5>
                            <div class="p-2 border border-secondary rounded-3 d-inline-block">
                                @if (!string.IsNullOrEmpty(Model.HinhAnh))
                                {
                                    @* Hiển thị hình ảnh sản phẩm *@
                                    <img src="@Url.Content(Model.HinhAnh)" 
                                         alt="Hình ảnh Sản phẩm @Model.TenSP" 
                                         class="img-fluid rounded shadow-sm" 
                                         style="max-height: 250px; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="fas fa-image fa-8x text-secondary"></i>
                                }
                            </div>
                        </div>

                        @* Cột 2: Thông tin cơ bản và Chi tiết (8/12 cột) *@
                        <div class="col-md-8">
                            <h2 class="text-dark mb-4">@Html.DisplayFor(model => model.TenSP)</h2>

                            @* Khối thông tin quan trọng *@
                            <ul class="list-group list-group-flush border rounded mb-4">
                                
                                @* Mã SP & Danh Mục *@
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-light">
                                    <span class="text-muted">Mã Sản Phẩm: </span>
                                    <strong>@Html.DisplayFor(model => model.MaSP)</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span class="text-muted">Danh Mục: </span>
                                    <strong>@Html.DisplayFor(model => model.DanhMuc.TenLoai)</strong>
                                </li>

                                @* Giá & Số lượng *@
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-light">
                                    <span class="text-muted">@Html.DisplayNameFor(model => model.Gia)</span>
                                    <strong class="text-danger fs-5">@String.Format("{0:N0} VNĐ", Model.Gia)</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span class="text-muted">@Html.DisplayNameFor(model => model.SoLuong) (Tồn kho)</span>
                                    <span class="badge bg-dark rounded-pill fs-6">@Html.DisplayFor(model => model.SoLuong)</span>
                                </li>
                            </ul>
                            
                            @* Mô tả *@
                            <div class="mt-4">
                                <h5 class="text-dark">@Html.DisplayNameFor(model => model.MoTa)</h5>
                                <p class="text-muted" style="white-space: pre-wrap;">@Html.DisplayFor(model => model.MoTa)</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                @* Card Footer cho các nút hành động *@
                <div class="card-footer text-end">
                    @Html.ActionLink("CHỈNH SỬA", "Edit", new { id = Model.MaSP }, new { @class = "btn btn-dark me-2 shadow-sm" })
                    @Html.ActionLink("QUAY LẠI DANH SÁCH", "Index", null, new { @class = "btn btn-outline-secondary" })
                </div>
            </div>
        </div>
    </div>
</div>