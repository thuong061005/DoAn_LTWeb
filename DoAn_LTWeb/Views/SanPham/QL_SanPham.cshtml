@model IEnumerable<DoAn_LTWeb.Models.SanPham>
@using DoAn_LTWeb.Models

@{
    ViewBag.Title = "QL_SanPham";
    // Lấy danh sách các Danh mục duy nhất để hiển thị ở thanh bên (Sidebar)
    var Ds_DanhMuc = ViewBag.DS_DanhMuc as List<DanhMuc>;
}
<style>
    #fab-add-product {
        position: fixed; /* Cố định vị trí trên màn hình */
        bottom: 30px; /* Cách lề dưới 30px */
        right: 30px; /* Cách lề phải 30px */
        z-index: 1000; /* Đảm bảo nút luôn nằm trên các thành phần khác */
        width: 60px; /* Đặt chiều rộng cố định */
        height: 60px; /* Đặt chiều cao cố định */
        border-radius: 50%; /* Làm cho nút có hình tròn */
        padding: 0;
        display: flex; /* Dùng Flexbox để căn giữa icon */
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3); /* Thêm đổ bóng để nổi bật */
        font-size: 1.5rem; /* Điều chỉnh kích thước icon bên trong */
    }

        /* Tùy chỉnh hover nếu cần */
        #fab-add-product:hover {
            opacity: 0.9;
        }
</style>

<div class="container-fluid">
    <h2 class="mt-4 mb-4 text-primary">
        <i class="fas fa-box-open"></i> Quản Lý Sản Phẩm
    </h2>

    <div class="row">

        <div class="col-md-3">
            <div class="card bg-dark text-white">
                <div class="card-header">
                    <i class="fas fa-list-alt"></i> Danh Mục
                </div>
                <div class="list-group list-group-flush">                  
                    @foreach (var dm in Ds_DanhMuc)
                    {
                        // Giả định bạn có thể lọc sản phẩm theo MaLoai (ID của Danh Mục)
                        <a href="@Url.Action("QL_SanPham", new { id = dm.MaDM })" class="list-group-item list-group-item-action list-group-item-dark">
                            @dm.TenLoai
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-9">

            @*<p>
                <a href="@Url.Action("Create")" class="btn btn-dark mb-3">
                    <i class="fas fa-plus-circle"></i> Thêm Sản Phẩm
                </a>
            </p>*@

            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 12%;">Ảnh</th>
                            <th style="width: 25%;">@Html.DisplayNameFor(model => model.TenSP)</th>
                            <th style="width: 10%;">@Html.DisplayNameFor(model => model.Gia)</th>
                            <th style="width: 5%;">@Html.DisplayNameFor(model => model.SoLuong)</th>
                            <th style="width: 25%;" class="text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int stt = 1; }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@stt</td>
                                <td>
                                    <img src="@Url.Content("~/Content/Images/" + item.HinhAnh)" alt="@item.TenSP"
                                         class="img-thumbnail" style="max-height: 70px; max-width: 70px; object-fit: cover;" />
                                </td>
                                <td>
                                    <strong>@Html.DisplayFor(modelItem => item.TenSP)</strong>
                                    @*<small class="text-muted d-block mt-1">@Html.DisplayFor(modelItem => item.MoTa)</small>*@
                                </td>
                                <td>
                                    <span class="text-danger font-weight-bold">
                                        @string.Format("{0:N0} VNĐ", item.Gia)
                                    </span>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SoLuong)
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("Edit", new { id = item.MaSP })" class="btn btn-sm btn-primary mb-1">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <a href="@Url.Action("Details", new { id = item.MaSP })" class="btn btn-sm btn-info mb-1">
                                        <i class="fas fa-info-circle"></i> Chi tiết
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.MaSP })" class="btn btn-sm btn-danger mb-1" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?');">
                                        <i class="fas fa-trash-alt"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                            stt++;
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
<a href="@Url.Action("Create")" id="fab-add-product" class="btn btn-dark" title="Thêm Sản Phẩm Mới">
    <i class="fas fa-plus fa-2x"></i>
</a>