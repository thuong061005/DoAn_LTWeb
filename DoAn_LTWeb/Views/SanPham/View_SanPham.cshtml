@model IEnumerable<DoAn_LTWeb.Models.SanPham>
@using DoAn_LTWeb.Models

@{
    ViewBag.Title = "QL_SanPham";
    // Lấy danh sách các Danh mục duy nhất để hiển thị ở thanh bên (Sidebar)
    var Ds_DanhMuc = ViewBag.DS_DanhMuc as List<DanhMuc>;
}
<style>
    /* -------------------------- */
    /* CSS CHUNG & HIỆU ỨNG CARD */
    /* -------------------------- */
    .product-card {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    }

        .product-card:hover {
            transform: translateY(-5px); /* Hiệu ứng nổi nhẹ khi hover */
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2) !important;
        }

    /* ĐIỀU CHỈNH: Giảm chiều cao ảnh từ 200px xuống 160px để thẻ thấp lại */
    .card-img-top {
        height: 160px;
        object-fit: contain;
        background-color: #f8f9fa;
        padding: 10px;
    }

    /* -------------------------- */
    /* FLOATING ACTION BUTTON (FAB) */
    /* -------------------------- */
    #fab-add-product {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 1000;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.4);
        font-size: 1.5rem;
        background-color: #17a2b8;
        border: none;
    }

        #fab-add-product:hover {
            background-color: #138496;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
        }
</style>

<div class="container-fluid mt-4">
    @*<h2 class="mb-5 text-secondary border-bottom border-light pb-2 fw-bold">
        <i class="fas fa-boxes me-2"></i> DANH SÁCH SẢN PHẨM
    </h2>*@
    <div class="row">

        @* Thanh bên: Danh Mục *@
        <div class="col-md-3">
            <div class="card shadow-lg mb-4">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="fas fa-filter me-2"></i> BỘ LỌC DANH MỤC
                </div>
                <div class="list-group list-group-flush">                   
                    @if (Ds_DanhMuc != null)
                    {
                        foreach (var dm in Ds_DanhMuc)
                        {
                            <a href="@Url.Action("View_SanPham", new { id = dm.MaDM })" class="list-group-item list-group-item-action list-group-item-light text-muted">
                                @dm.TenLoai
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        @* Khu vực chính: Danh sách Sản phẩm *@
        <div class="col-md-9">
            <div class="row products-section">
                @foreach (var item in Model)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-4">
                        <div class="card product-card shadow-sm border">
                            <span class="product-badge bg-danger position-absolute top-0 start-0 m-2 text-white">-31%</span>
                            <i class="fas fa-heart position-absolute top-0 end-0 m-3 text-white opacity-75" title="Yêu thích"></i>
                            @{
                                string imagePath = string.IsNullOrEmpty(item.HinhAnh) ? "~/Content/placeholder.png" : "~/Content/Images/" + item.HinhAnh;
                            }
                            <img src="@Url.Content(imagePath)"
                                 class="card-img-top"
                                 alt="@item.TenSP"
                                 loading="lazy">
                            <div class="card-body text-center d-flex flex-column">
                                <h6 class="card-title fw-bold text-truncate">@item.TenSP</h6>                                
                                <p class="card-text mb-2">
                                    <span class="text-danger fw-bolder fs-5 me-2">@String.Format("{0:N0}₫", item.Gia)</span>
                                </p>
                                <span class="badge bg-secondary mb-3">Kho: @item.SoLuong</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

