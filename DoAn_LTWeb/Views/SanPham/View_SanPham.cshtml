@model IEnumerable<DoAn_LTWeb.Models.SanPham>
@using DoAn_LTWeb.Models

@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var Ds_DanhMuc = ViewBag.DS_DanhMuc as List<DanhMuc>;
}

<style>
    /* --- CSS TÙY CHỈNH --- */
    .product-card {
        transition: all 0.3s ease;
        border: 1px solid #e0e0e0;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
            border-color: #0d6efd;
        }

    .card-img-wrapper {
        height: 200px; /* Cố định chiều cao khung ảnh */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
        background: #fff;
        overflow: hidden;
    }

    .card-img-top {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        transition: transform 0.3s;
    }

    .product-card:hover .card-img-top {
        transform: scale(1.08); /* Phóng to ảnh nhẹ khi hover */
    }

    .product-title a {
        color: #333;
        transition: color 0.2s;
        display: -webkit-box;
        -webkit-line-clamp: 2; /* Giới hạn tên 2 dòng */
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 48px; /* Chiều cao cố định cho tên */
    }

        .product-title a:hover {
            color: #0d6efd;
            text-decoration: none;
        }
</style>

<div class="container py-4">
    <div class="row">

        @* --- CỘT TRÁI: DANH MỤC --- *@
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold py-3">
                    <i class="fas fa-bars me-2"></i> DANH MỤC
                </div>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("QL_SanPham", "SanPham")" class="list-group-item list-group-item-action fw-bold">
                        Tất cả sản phẩm
                    </a>
                    @if (Ds_DanhMuc != null)
                    {
                        foreach (var dm in Ds_DanhMuc)
                        {
                            <a href="@Url.Action("View_SanPham", new { id = dm.MaDM })" class="list-group-item list-group-item-action">
                                <i class="fas fa-angle-right me-2 text-secondary"></i> @dm.TenLoai
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        @* --- CỘT PHẢI: DANH SÁCH SẢN PHẨM --- *@
        <div class="col-lg-9">

            @if (Model.Count() == 0)
            {
                <div class="alert alert-info text-center">
                    Hiện chưa có sản phẩm nào trong danh mục này.
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <div class="card product-card h-100">

                                <span class="position-absolute top-0 start-0 bg-danger text-white badge m-2 rounded-pill">-15%</span>

                                <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = item.MaSP })" class="card-img-wrapper">
                                    @{
                                        string imagePath = string.IsNullOrEmpty(item.HinhAnh) ? "~/Content/Images/no-image.jpg" : "~/Content/Images/" + item.HinhAnh;
                                    }
                                    <img src="@Url.Content(imagePath)" class="card-img-top" alt="@item.TenSP">
                                </a>

                                <div class="card-body d-flex flex-column p-3">
                                    <h6 class="card-title product-title fw-bold mb-2">
                                        <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = item.MaSP })" class="text-decoration-none">
                                            @item.TenSP
                                        </a>
                                    </h6>

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-danger fw-bold fs-5">@String.Format("{0:N0}₫", item.Gia)</span>
                                            @if (item.SoLuong > 0)
                                            {
                                                <small class="text-success"><i class="fas fa-check"></i> Còn hàng</small>
                                            }
                                            else
                                            {
                                                <small class="text-secondary"><i class="fas fa-times"></i> Hết hàng</small>
                                            }
                                        </div>
                                    </div>

                                    <div class="mt-auto">
                                        <div class="d-grid gap-2">
                                            <a href="@Url.Action("ThemVaoGio", "GioHang", new { maSP = item.MaSP, strURL = Request.Url.ToString() })"
                                               class="btn btn-outline-danger btn-sm">
                                                <i class="fas fa-cart-plus me-1"></i> Thêm vào giỏ
                                            </a>

                                            <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = item.MaSP })"
                                               class="btn btn-primary btn-sm">
                                                <i class="fas fa-eye me-1"></i> Xem chi tiết
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>