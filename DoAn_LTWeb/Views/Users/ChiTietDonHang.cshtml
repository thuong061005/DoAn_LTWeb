@model DoAn_LTWeb.Models.HoaDon
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.MaHD;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="mb-4">
        <a href="@Url.Action("LichSuDonHang", "Users")" class="text-decoration-none text-secondary">
            <i class="fas fa-arrow-left me-2"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold">
                    Thông tin đơn hàng #@Model.MaHD
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Ngày đặt:</strong> @String.Format("{0:dd/MM/yyyy HH:mm}", Model.NgayTao)</p>
                    <p class="mb-2"><strong>Người nhận:</strong> @Model.User.HoTen</p>
                    <p class="mb-2"><strong>Số điện thoại:</strong> @Model.User.SDT</p>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span>Tạm tính:</span>
                        <span class="fw-bold">@String.Format("{0:N0}₫", Model.TongTien)</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Vận chuyển:</span>
                        <span>@String.Format("{0:N0}₫", Model.VanChuyen)</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between fs-5 text-danger fw-bold">
                        <span>Tổng cộng:</span>
                        <span>@String.Format("{0:N0}₫", Model.ThanhTien)</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold py-3">
                    Danh sách sản phẩm
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ct in Model.CTHDs)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            @* Hiển thị ảnh sản phẩm *@
                                            <img src="~/Content/Images/@ct.SanPham.HinhAnh"
                                                 class="rounded border me-3"
                                                 style="width: 50px; height: 50px; object-fit: cover;">
                                            <div>
                                                <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = ct.MaSP })" class="text-dark text-decoration-none fw-bold">
                                                    @ct.SanPham.TenSP
                                                </a>
                                                <div class="text-muted small">
                                                    Đơn giá: @String.Format("{0:N0}₫", ct.ThanhTien / ct.SoLuong)
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">x @ct.SoLuong</td>
                                    <td class="text-end fw-bold text-danger pe-4">
                                        @String.Format("{0:N0}₫", ct.ThanhTien)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>