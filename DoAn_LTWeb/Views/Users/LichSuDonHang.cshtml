@model List<DoAn_LTWeb.Models.HoaDon>
@{
    ViewBag.Title = "Lịch sử mua hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <h3 class="mb-4 fw-bold text-uppercase"><i class="fas fa-history me-2"></i> Lịch sử đơn hàng</h3>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center">
            Bạn chưa có đơn hàng nào. <a href="@Url.Action("View_SanPham", "SanPham")" class="fw-bold">Mua sắm ngay!</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 ps-4">Mã đơn</th>
                            <th class="py-3">Ngày đặt</th>
                            <th class="py-3">Tổng tiền</th>
                            <th class="py-3">Trạng thái</th>
                            <th class="py-3 text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@item.MaHD</td>
                                <td>@String.Format("{0:dd/MM/yyyy}", item.NgayTao)</td>
                                <td class="fw-bold text-danger">@String.Format("{0:N0}₫", item.ThanhTien)</td>
                                <td>
                                    @* Giả sử bạn chưa có cột Trạng Thái, hiển thị mặc định *@
                                    <span class="badge bg-success">Thành công</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("ChiTietDonHang", "Users", new { id = item.MaHD })"
                                       class="btn btn-sm btn-outline-dark">
                                        <i class="fas fa-eye"></i> Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>