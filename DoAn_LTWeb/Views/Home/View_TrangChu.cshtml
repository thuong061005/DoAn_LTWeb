@{
    ViewBag.Title = "Trang Chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Lấy danh sách danh mục từ Controller
    var listDanhMuc = ViewBag.DS_DanhMuc as List<DoAn_LTWeb.Models.DanhMuc>;
}

<style>
    /* ==================== 1. CSS CHO CAROUSEL (SLIDER) ==================== */
    .carousel-item {
        height: 450px; /* Chiều cao banner */
        background-color: #000;
    }

    .carousel-banner {
        height: 100%;
        background-size: cover;
        background-position: center;
        position: relative;
    }

    /* Tạo lớp phủ đen mờ để chữ nổi bật hơn */
    .overlay-bg {
        background: rgba(0, 0, 0, 0.4);
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1;
    }

    .carousel-caption {
        z-index: 2;
        bottom: 20%; /* Đẩy chữ lên cao một chút */
    }

    /* Banner 1: Giả lập ảnh bằng Gradient (Bạn thay url ảnh thật vào đây) */
    .banner-1 {
        background-image: url('https://images.unsplash.com/photo-1556742049-0cfed4f7a07d?auto=format&fit=crop&w=1600&q=80');
        /* Nếu chưa có ảnh, dùng màu nền tạm: */
        /* background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); */
    }

    /* Banner 2: Giả lập ảnh */
    .banner-2 {
        background-image: url('https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?auto=format&fit=crop&w=1600&q=80');
        /* background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%); */
    }

    /* ==================== 2. CSS CHO DANH MỤC (CATEGORY) ==================== */
    .category-card {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 1px solid #f0f0f0;
        background: #fff;
        border-radius: 15px;
        text-align: center;
        padding: 25px 15px;
        cursor: pointer;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
            border-color: #0d6efd;
        }

    .cat-icon-box {
        width: 70px;
        height: 70px;
        line-height: 70px;
        border-radius: 50%;
        background-color: #f8f9fa;
        margin-bottom: 15px;
        transition: all 0.3s;
        font-size: 28px;
        color: #555;
    }

    .category-card:hover .cat-icon-box {
        background-color: #0d6efd;
        color: #fff;
        transform: rotateY(360deg); /* Hiệu ứng xoay icon khi hover */
    }

    .cat-title {
        font-weight: 700;
        color: #444;
        font-size: 1rem;
    }

    .category-card:hover .cat-title {
        color: #0d6efd;
    }
</style>

<div id="mainCarousel" class="carousel slide mb-5" data-bs-ride="carousel" data-bs-interval="4000">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1"></button>
    </div>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="carousel-banner banner-1 d-flex align-items-center justify-content-center text-center">
                <div class="overlay-bg"></div> <div class="carousel-caption">
                    <span class="badge bg-danger mb-3 fs-6">KHUYẾN MÃI HOT</span>
                    <h1 class="fw-bold display-4 text-white mb-3" style="text-shadow: 2px 2px 10px rgba(0,0,0,0.5);">ĐẠI TIỆC CÔNG NGHỆ 2025</h1>
                    <p class="fs-5 text-white-50 w-75 mx-auto d-none d-md-block">Săn ngay iPhone 15, Laptop Gaming và hàng ngàn phụ kiện với giá giảm sốc lên đến 50%.</p>
                    <a href="@Url.Action("View_SanPham", "SanPham")" class="btn btn-light btn-lg fw-bold mt-4 px-5 rounded-pill shadow">
                        MUA NGAY <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="carousel-item">
            <div class="carousel-banner banner-2 d-flex align-items-center justify-content-center text-center">
                <div class="overlay-bg"></div>
                <div class="carousel-caption">
                    <span class="badge bg-warning text-dark mb-3 fs-6">THÀNH VIÊN MỚI</span>
                    <h1 class="fw-bold display-4 text-white mb-3" style="text-shadow: 2px 2px 10px rgba(0,0,0,0.5);">ƯU ĐÃI ĐỘC QUYỀN</h1>
                    <p class="fs-5 text-white-50 w-75 mx-auto d-none d-md-block">Giảm thêm 15% cho đơn hàng đầu tiên khi đăng ký thành viên ngay hôm nay.</p>
                    <a href="@Url.Action("DangKy", "Login")" class="btn btn-primary btn-lg fw-bold mt-4 px-5 rounded-pill shadow">
                        ĐĂNG KÝ NGAY
                    </a>
                </div>
            </div>
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon p-3 bg-dark rounded-circle bg-opacity-50" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon p-3 bg-dark rounded-circle bg-opacity-50" aria-hidden="true"></span>
    </button>
</div>

<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h3 class="fw-bold text-uppercase m-0 text-dark">
            <i class="fas fa-th-large text-primary me-2"></i> Danh Mục Nổi Bật
        </h3>
        <a href="@Url.Action("View_SanPham", "SanPham")" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold">
            Xem tất cả <i class="fas fa-angle-right ms-1"></i>
        </a>
    </div>

    @if (listDanhMuc != null && listDanhMuc.Any())
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-4">
            @foreach (var item in listDanhMuc)
            {
                // Mapping Icon theo tên danh mục
                string iconClass = "fa-box-open";
                string ten = item.TenLoai.ToLower();
                if (ten.Contains("điện thoại")) { iconClass = "fa-mobile-alt"; }
                else if (ten.Contains("laptop")) { iconClass = "fa-laptop"; }
                else if (ten.Contains("phụ kiện")) { iconClass = "fa-headphones-alt"; }
                else if (ten.Contains("âm thanh")) { iconClass = "fa-music"; }
                else if (ten.Contains("gia dụng")) { iconClass = "fa-blender"; }
                else if (ten.Contains("máy tính bảng")) { iconClass = "fa-tablet-alt"; }
                else if (ten.Contains("watch")) { iconClass = "fa-clock"; }

                <div class="col">
                    <a href="@Url.Action("View_SanPham", "SanPham", new { id = item.MaDM })" class="text-decoration-none">
                        <div class="category-card">
                            <div class="cat-icon-box shadow-sm d-flex align-items-center justify-content-center">
                                <i class="fas @iconClass"></i>
                            </div>
                            <span class="cat-title">@item.TenLoai</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">Đang cập nhật danh mục...</div>
    }
</div>

<div class="container pb-5">
    <div class="text-center mb-4">
        <h3 class="fw-bold">Gợi ý hôm nay</h3>
        <p class="text-muted">Những sản phẩm được quan tâm nhất</p>
    </div>
</div>