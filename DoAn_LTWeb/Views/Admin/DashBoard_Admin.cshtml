@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        /* ==================== CSS TÙY CHỈNH ==================== */

        /* Đảm bảo toàn bộ body và container chiếm hết chiều cao màn hình */
        body, #wrapper {
            height: 100vh;
        }

        /* ---------------- Sidebar Style ---------------- */
        .sidebar {
            background-color: #212529; /* Màu nền đen mờ (Dark) */
            color: #f8f9fa;
            transition: all 0.3s;
            box-shadow: 4px 0 10px rgba(0, 0, 0, 0.2);
        }

        /* Tiêu đề Logo/Brand */
        .sidebar-heading {
            padding: 1.5rem 1rem;
            font-size: 1.25rem;
            font-weight: bold;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            color: #ffc107; /* Màu vàng nổi bật cho tên thương hiệu */
        }

        /* Các mục menu */
        .list-group-item {
            background-color: transparent;
            color: #adb5bd; /* Màu chữ xám nhạt */
            border: none;
            padding: 0.75rem 1rem;
            border-radius: 0;
            transition: background-color 0.2s, color 0.2s;
        }

            .list-group-item i {
                width: 25px; /* Giúp icon căn chỉnh đều */
                text-align: center;
            }

            /* Hiệu ứng hover/active */
            .list-group-item:hover, .list-group-item.active {
                background-color: #343a40; /* Màu nền đậm hơn khi hover */
                color: #ffffff; /* Chữ trắng khi hover */
                border-left: 5px solid #0dcaf0; /* Thanh màu xanh nổi bật bên trái */
            }

            .list-group-item.active {
                font-weight: bold;
            }

        /* ---------------- Nội dung chính ---------------- */
        .main-content {
            background-color: #f8f9fa; /* Màu nền nhẹ cho khu vực làm việc */
            padding: 20px;
            overflow-y: auto; /* Cho phép cuộn nếu nội dung quá dài */
        }

        /* Chiều rộng sidebar (25% trên màn hình lớn) */
        .sidebar-container {
            width: 25%;
            min-width: 250px; /* Chiều rộng tối thiểu cho dễ đọc */
        }

        /* Media Queries cho chiều rộng (Nếu muốn 30% thì thay đổi ở đây) */
        @@media (min-width: 1200px) {
            .sidebar-container {
                /* Chiếm 30% trên màn hình desktop cực lớn */
                /* width: 30%; */
            }
        }

        @@media (max-width: 768px) {
            .sidebar-container {
                width: 100%; /* Chiếm toàn màn hình trên mobile */
                height: auto;
            }
        }

        /* Thẻ Stats Card */
        .stats-card {
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s;
        }

            .stats-card:hover {
                transform: translateY(-3px);
            }
    </style>
</head>
<body>

    <div id="wrapper" class="d-flex">

        <div class="sidebar-container d-flex flex-column sidebar">

            <div class="sidebar-heading">
                Shop Admin Panel
            </div>

            <div class="list-group list-group-flush flex-grow-1">
                <a href="#" class="list-group-item list-group-item-action active">
                    <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="fas fa-box me-2"></i> Quản lý Sản phẩm
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="fas fa-tags me-2"></i> Quản lý Danh mục
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="fas fa-shopping-cart me-2"></i> Quản lý Đơn hàng
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="fas fa-users me-2"></i> Quản lý Khách hàng
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="fas fa-chart-line me-2"></i> Báo cáo & Thống kê
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="fas fa-envelope me-2"></i> Phản hồi
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="fas fa-cog me-2"></i> Cài đặt Website
                </a>
            </div>

            <div class="p-3 border-top border-secondary">
                <a href="#" class="list-group-item list-group-item-action text-danger">
                    <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                </a>
            </div>

        </div>

        @* Khu vục hiển thị nội dung *@

        <div class="main-content flex-grow-1">

            <nav class="navbar navbar-expand-lg navbar-light bg-white rounded shadow-sm mb-4 p-3">
                <span class="fs-5 fw-bold text-dark">Trang Chủ Dashboard</span>
                <div class="ms-auto">
                    <button class="btn btn-outline-secondary me-2"><i class="fas fa-bell"></i></button>
                    <span class="fw-bold me-2">Chào, Admin!</span>
                    <i class="fas fa-user-circle fs-4 text-primary"></i>
                </div>
            </nav>

            <h2 class="mb-4">Tổng quan</h2>
            <div class="row">

                <div class="col-md-3 mb-4">
                    <div class="card stats-card bg-primary text-white">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-shopping-cart"></i> Đơn hàng mới</h5>
                            <p class="card-text fs-3 fw-bold">120</p>
                            <small>Xem chi tiết</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-4">
                    <div class="card stats-card bg-success text-white">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-dollar-sign"></i> Doanh thu </h5>
                            <p class="card-text fs-3 fw-bold">15.5 Tr</p>
                            <small>Xem báo cáo</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-4">
                    <div class="card stats-card bg-warning text-dark">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-users"></i> Khách hàng mới</h5>
                            <p class="card-text fs-3 fw-bold">45</p>
                            <small>Xem danh sách</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-4">
                    <div class="card stats-card bg-info text-white">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fas fa-box"></i> Tổng sản phẩm</h5>
                            <p class="card-text fs-3 fw-bold">2,145</p>
                            <small>Quản lý kho</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-lg-8 mb-4">
                    <div class="card shadow-sm p-4">
                        <h4 class="card-title">Biểu đồ Doanh thu (Ví dụ)</h4>
                        <div style="height: 300px; background-color: #eee; text-align: center; line-height: 300px;">
                            [Khu vực Biểu đồ]
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 mb-4">
                    <div class="card shadow-sm p-4">
                        <h4 class="card-title">Hoạt động gần đây</h4>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">Khách hàng A đặt hàng (#9001)</li>
                            <li class="list-group-item">Sản phẩm X hết hàng</li>
                            <li class="list-group-item">Admin B cập nhật giá</li>
                            <li class="list-group-item">Khách hàng C đăng ký mới</li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>