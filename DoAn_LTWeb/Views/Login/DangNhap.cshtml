@{
    ViewBag.Title = "Đăng Nhập";
    // Giả sử bạn vẫn muốn sử dụng Layout chung
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-lg-5 col-md-7 col-sm-10">
            <div class="card shadow-lg p-4">
                <h3 class="card-title text-center mb-4">Đăng Nhập Hệ Thống</h3>
                @using (Html.BeginForm("XuLiDangNhap", "Login", FormMethod.Post, new { @class = "form-horizontal", autocomplete = "on" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    <form method="post" action="/[Controller]/[ActionDangNhap]">
                        @if (ViewBag.ThongBao != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @ViewBag.ThongBao
                            </div>
                        }
                        <div class="mb-3">
                            <label for="tenDN" class="form-label">Tên đăng nhập</label>
                            <input type="text"
                                   class="form-control"
                                   id="tenDN"
                                   name="tenDN"
                                   placeholder="Nhập tên đăng nhập..."
                                   required>
                        </div>
                        <div class="mb-3">
                            <label for="mk" class="form-label">Mật khẩu</label>
                            <input type="password"
                                   class="form-control"
                                   id="mk"
                                   name="mk"
                                   placeholder="Nhập mật khẩu..."
                                   required>
                        </div>
                        <div class="mb-3 d-flex justify-content-between align-items-center">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="GhiNho">
                                <label class="form-check-label" for="GhiNho">Ghi nhớ tôi</label>
                            </div>
                            <a href="#" class="text-decoration-none">Quên mật khẩu?</a>
                        </div>
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Đăng Nhập</button>
                        </div>
                    </form>
                }
                <div class="text-center mt-3">
                    Chưa có tài khoản? <a href="#" class="text-decoration-none">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>